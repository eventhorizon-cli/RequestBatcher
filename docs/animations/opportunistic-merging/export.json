{
  "width": 1100,
  "height": 900,
  "outputWidth": 3840,
  "duration": 15,
  "fps": 20,
  "selector": ".demo",
  "ready": "typeof render === 'function' && document.documentElement.lang === (new URLSearchParams(location.search).get('lang') === 'zh-CN' ? 'zh-CN' : 'en')",
  "css": "header,footer,.controls{display:none!important} main{max-width:none;margin:0;padding:0} .demo{border:0;border-radius:0} body{background:white}",
  "seek": "t => { const slider=document.querySelector('#timeline'); slider.value=t/1.5; slider.dispatchEvent(new Event('input')); }",
  "checkpoints": [
    {
      "time": 4.05,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [3, 2, 0]
    },
    {
      "time": 5.55,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [6, 2, 0]
    },
    {
      "time": 8.625,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [2, 2, 1]
    },
    {
      "time": 10.5,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [0, 2, 2]
    },
    {
      "time": 12.75,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [0, 1, 4]
    },
    {
      "time": 14.25,
      "evaluate": "['queued-count','active-count','completed-count'].map(id=>Number(document.getElementById(id).textContent))",
      "equals": [0, 0, 8]
    }
  ]
}
