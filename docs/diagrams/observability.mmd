flowchart LR
    %% When at least one corresponding Execute span is sampled, Handle links to all participating Execute contexts, including unsampled Execute spans; if all are unsampled, Handle is not sampled.
    %% A sampled Execute requesting data links only to the Handle spans processing its requests, before it ends.
    %% Neither Execute nor Handle is the other's parent.
    subgraph A[Service A: caller and RequestBatcher]
        HTTPA[Caller HTTP span] --> EXEC[RequestBatcher.Execute<br/>Internal span]
        EXEC -. "queued work" .-> BATCH[RequestBatcher.Handle<br/>Consumer root span]
        BATCH --> HANDLER[Handler / HTTP client<br/>child span]
        BATCH -. "Handle → Execute<br/>link, not a parent edge" .-> EXEC
        EXEC -. "Execute → Handle<br/>added before Execute ends" .-> BATCH
    end

    subgraph B[Service B: downstream]
        HTTPB[HTTP server span] --> DB[Database child span]
    end

    HANDLER --> HTTPB

    classDef caller fill:#eaf2ff,stroke:#3567a7,color:#1d3b66
    classDef batch fill:#edf1f5,stroke:#596773,color:#303b44
    classDef downstream fill:#f4edfb,stroke:#75529b,color:#422d59
    class HTTPA,EXEC caller
    class BATCH,HANDLER batch
    class HTTPB,DB downstream
