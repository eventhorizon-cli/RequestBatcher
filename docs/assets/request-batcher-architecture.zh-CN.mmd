flowchart LR
    subgraph callers["并发调用方"]
        direction TB
        callerA["调用方 A<br/>请求 A"]
        callerB["调用方 B<br/>请求 B"]
        callerC["调用方 C<br/>请求 C"]
    end

    subgraph requestBatcher["RequestBatcher"]
        direction TB
        coordinator["请求批次<br/>协调器"]
        queue["内部 BufferQueue<br/>按 Partition 路由"]
        completion["每个已接收请求一个 Task<br/>成功 / 失败"]
        coordinator -->|入队| queue
    end

    subgraph processing["批处理"]
        direction TB
        handler["Handler<br/>最多处理 BatchSize 个请求"]
        downstream["数据库、缓存<br/>或批量 API"]
        handler -->|批量操作| downstream
    end

    callerA -->|单个请求| coordinator
    callerB -->|单个请求| coordinator
    callerC -->|单个请求| coordinator
    queue -->|拉取批次| handler
    handler -.->|实际结果| completion

    class callerA,callerB,callerC client
    class coordinator gateway
    class queue,completion core
    class handler handler
    class downstream storage

    classDef client fill:#e9f6f1,stroke:#2f6f5e,color:#173f35,stroke-width:1.5px
    classDef gateway fill:#eaf2ff,stroke:#3567a7,color:#1d3b66,stroke-width:1.5px
    classDef core fill:#edf1f5,stroke:#596773,color:#303b44,stroke-width:1.5px
    classDef storage fill:#fff4d6,stroke:#8a6a1d,color:#4d3b0e,stroke-width:1.5px
    classDef handler fill:#f4edfb,stroke:#75529b,color:#422d59,stroke-width:1.5px
    style callers fill:#ffffff,stroke:#aeb8c2,color:#303b44,stroke-width:1px
    style requestBatcher fill:#ffffff,stroke:#aeb8c2,color:#303b44,stroke-width:1px
    style processing fill:#ffffff,stroke:#aeb8c2,color:#303b44,stroke-width:1px
