<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RequestBatcher' and '$(RequestBatcherVersion)' != ''">
    <Version>$(RequestBatcherVersion)</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RequestBatcher.OpenTelemetry' and '$(RequestBatcherOpenTelemetryVersion)' != ''">
    <Version>$(RequestBatcherOpenTelemetryVersion)</Version>
  </PropertyGroup>
</Project>
