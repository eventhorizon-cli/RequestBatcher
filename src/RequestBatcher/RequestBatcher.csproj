<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Title>RequestBatcher</Title>
    <PackageId>RequestBatcher</PackageId>
    <Description>In-process request batching for concurrent .NET workloads, with backpressure, partition routing, and per-request completion.</Description>
    <Authors>EventHorizon CLI</Authors>
    <PackageTags>request-batching;batching;async;backpressure;partitioning;bufferqueue</PackageTags>
    <PackageProjectUrl>https://github.com/eventhorizon-cli/RequestBatcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eventhorizon-cli/RequestBatcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BufferQueue" Version="2.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RequestBatcher.Tests" />
    <InternalsVisibleTo Include="RequestBatcher.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RequestBatcher.Analyzers/RequestBatcher.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../RequestBatcher.Analyzers/bin/$(Configuration)/netstandard2.0/RequestBatcher.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Update="README.md" Pack="true" PackagePath="/" Condition="'$(TargetFramework)' != ''" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="'$(TargetFramework)' == ''" />
  </ItemGroup>
</Project>
