<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Title>RequestBatcher OpenTelemetry Instrumentation</Title>
    <PackageId>RequestBatcher.OpenTelemetry</PackageId>
    <Description>OpenTelemetry instrumentation for RequestBatcher.</Description>
    <Authors>EventHorizon CLI</Authors>
    <PackageTags>request-batching;opentelemetry;tracing;observability</PackageTags>
    <PackageProjectUrl>https://github.com/eventhorizon-cli/RequestBatcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eventhorizon-cli/RequestBatcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.20.1" />
    <ProjectReference Include="../RequestBatcher/RequestBatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" Condition="'$(TargetFramework)' != ''" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="'$(TargetFramework)' == ''" />
  </ItemGroup>
</Project>
